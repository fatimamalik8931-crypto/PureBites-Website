# =========================================================
#  Pure Bites — server environment
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real ".env" file.
# =========================================================

# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Where the browser frontend is served from ----
# Used for CORS. Comma-separate multiple origins if needed.
CLIENT_ORIGIN=http://localhost:4000

# ---- Database ----
# Development uses SQLite (a single local file). No install needed.
# For production, switch this to a PostgreSQL URL and update
# prisma/schema.prisma's datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# ---- Auth (used from Phase 5 onwards; harmless to set now) ----
# Secret used to sign the admin session cookie. Use a long random string.
# In production the server refuses to start unless this is 32+ characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# The first admin account is created from these on first seed.
ADMIN_EMAIL=owner@purebites.local
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Pure Bites Owner

# ---- Email notifications (used from Phase 2 onwards) ----
# For Gmail: create an "App Password" (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
# Where notification emails are sent (the restaurant inbox).
NOTIFY_TO=youraddress@gmail.com
